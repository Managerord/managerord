{
  "name": "managero-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "gen:image-sizes": "node scripts/gen-image-sizes.mjs && biome format --write src/data/imageSizes.ts",
    "gen:critical-images": "node scripts/gen-critical-images.mjs",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "lint:format": "biome format --write ./src",
    "check": "biome check ./src",
    "typecheck": "astro check",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/vercel": "11.0.10",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.1",
    "lenis": "1.3.26",
    "resend": "^6.8.0",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "husky": "9.1.7",
    "sharp": "0.35.4"
  }
}
