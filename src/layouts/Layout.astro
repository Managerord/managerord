---
import "@/styles/global.css";
import {
	locations,
	US_TIME_ZONE_PREFIXES,
	US_TIME_ZONES,
} from "@/data/locations";
import { organizationSchema } from "@/data/organization";
import type { Locale } from "@/i18n/content";

interface Props {
	title?: string;
	description?: string;
	locale?: Locale;
	canonicalPath?: string;
	alternatePath?: string;
	image?: string;
	imageAlt?: string;
	noindex?: boolean;
	schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
	title = "Managero",
	description = "Creatividad con estructura.",
	locale = "es",
	canonicalPath = Astro.url.pathname,
	alternatePath,
	image = "/images/og/default.jpg",
	imageAlt,
	noindex = false,
	schema,
} = Astro.props;
const canonical = new URL(canonicalPath, Astro.site);
const alternateLocale = locale === "es" ? "en" : "es";
const socialImage = new URL(image, Astro.site);
const socialImageAlt = imageAlt ?? title;

const usContact = {
	phoneHref: locations.us.phone.href,
	phoneDisplay: locations.us.phone.display,
	address: locations.us.label[locale],
};
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
		{!noindex && <link rel="canonical" href={canonical} />}
		{!noindex && <link rel="alternate" hreflang={locale} href={canonical} />}
		{!noindex && alternatePath && <link rel="alternate" hreflang={alternateLocale} href={new URL(alternatePath, Astro.site)} />}
		{!noindex && alternatePath && <link rel="alternate" hreflang="x-default" href={new URL(locale === "es" ? canonicalPath : alternatePath, Astro.site)} />}
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Managero" />
		<meta property="og:locale" content={locale === "es" ? "es_DO" : "en_US"} />
		<meta property="og:locale:alternate" content={locale === "es" ? "en_US" : "es_DO"} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={socialImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage} />
		<meta name="twitter:image:alt" content={socialImageAlt} />
		<title>{title}</title>
		<script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
		{schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
		<link
			rel="preload"
			href="/fonts/nunito-v32-latin-regular.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/nordeco-bold.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/nordeco-regular.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
	</head>
	<body
		class="min-h-screen bg-warm-white text-charcoal antialiased font-sans"
	>
		<slot />
		<script is:inline define:vars={{ usContact, usZones: US_TIME_ZONES, usPrefixes: US_TIME_ZONE_PREFIXES }}>
			(() => {
				try {
					const zone = Intl.DateTimeFormat().resolvedOptions().timeZone || "";
					const inUS =
						usZones.includes(zone) ||
						usPrefixes.some((prefix) => zone.startsWith(prefix));
					if (!inUS) return;

					for (const link of document.querySelectorAll("[data-contact-phone]")) {
						link.setAttribute("href", "tel:" + usContact.phoneHref);
					}
					for (const el of document.querySelectorAll("[data-contact-phone-text]")) {
						el.textContent = usContact.phoneDisplay;
					}
					for (const el of document.querySelectorAll("[data-contact-address-text]")) {
						el.textContent = usContact.address;
					}
				} catch {
				}
			})();
		</script>
	</body>
</html>

<style>
	html {
		scroll-behavior: smooth;
		overflow-x: clip;
	}

	body {
		overflow-x: clip;
	}

	html.lenis,
	html.lenis body {
		height: auto;
	}

	.lenis.lenis-smooth {
		scroll-behavior: auto;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}
</style>

<script>
	import Lenis from "lenis";

	if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
		const lenis = new Lenis({ duration: 1.8, smoothWheel: true });
		const frame = (time: number) => {
			lenis.raf(time);
			requestAnimationFrame(frame);
		};
		requestAnimationFrame(frame);
	}
</script>
