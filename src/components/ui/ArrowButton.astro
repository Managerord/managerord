---
import ArrowUpRight from "@/assets/icons/arrow-up-right.svg";

interface Props {
	href?: string;
	class?: string;
	label?: string;
	variant?: "outline" | "solid";
}

const {
	href = "#",
	class: className = "",
	label = "Ver más",
	variant = "outline",
} = Astro.props;

const variants = {
	outline:
		"border border-neutral-300 text-charcoal hover:bg-neutral-900 hover:text-white",
	solid: "bg-orange-500 text-white hover:bg-orange-600",
};
---

<a
	href={href}
	aria-label={label}
	class={`inline-flex size-12 shrink-0 items-center justify-center rounded-full transition-colors lg:size-10 2xl:size-12 ${variants[variant]} ${className}`}
>
	<ArrowUpRight class="size-4 2xl:size-[18px]" />
</a>
