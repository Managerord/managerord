---
import Link2 from "@/assets/icons/link-2.svg";
import Settings from "@/assets/icons/settings.svg";
import Sparkle from "@/assets/icons/sparkle.svg";
import { sizeOf } from "@/data/imageSizes";
import { type Locale, ui } from "@/i18n/content";

interface Props {
	locale?: Locale;
}
const { locale = "es" } = Astro.props;
const copy = ui[locale].about;
const galleryImages = [
	"/images/mockups/coleccion_mockups_marcas.avif",
	"/images/mockups/botella_innovative.avif",
	"/images/mockups/botellas_marcas.avif",
	"/images/mockups/cintas_portacredenciales_marcas.avif",
	"/images/mockups/tazas_marcas.avif",
];
---

<section
	id={locale === "es" ? "nosotros" : "about"}
	class="px-4 pt-10.5 pb-5 sm:px-6 lg:px-8 lg:pt-8.5 lg:pb-4 2xl:px-14 2xl:pt-10.5 2xl:pb-5 max-sm:pt-8.5"
	aria-labelledby="about-title"
>
	<div class="mx-auto grid w-full max-w-425 grid-cols-[minmax(280px,0.62fr)_minmax(520px,1fr)] gap-[clamp(28px,4vw,64px)] lg:grid-cols-[minmax(224px,0.62fr)_minmax(416px,1fr)] lg:gap-10 2xl:grid-cols-[minmax(280px,0.62fr)_minmax(520px,1fr)] 2xl:gap-16 max-[900px]:grid-cols-1">
	<div class="pt-3.5 max-[900px]:pt-0">
		<h2 id="about-title" class="font-heading text-3xl leading-[0.98] font-bold tracking-[-0.035em] sm:text-5xl 2xl:text-6xl">{copy.titleTop}<br />{copy.titleBottom}</h2>
		<p class="mt-4 max-w-140 text-base leading-[1.48] text-[#3e3935] sm:mt-5.5 sm:text-xl lg:max-w-md 2xl:max-w-140 2xl:text-2xl max-[900px]:max-w-none">
			{copy.description}
		</p>

		<ul class="mt-6 flex flex-wrap gap-2.5 lg:mt-5 lg:gap-2 2xl:mt-6 2xl:gap-2.5" aria-label={copy.specialties}>
			<li class="inline-flex items-center gap-1.75 rounded-full bg-[#f6f2ec] px-3 py-2 text-sm font-semibold lg:gap-1.5 lg:px-2.5 lg:py-1.5 lg:text-xs 2xl:gap-1.75 2xl:px-3 2xl:py-2 2xl:text-sm">
				<Sparkle class="size-4.25 lg:size-3.5 2xl:size-4.25" aria-hidden="true" />
				{copy.items[0]}
			</li>
			<li class="inline-flex items-center gap-1.75 rounded-full bg-[#f6f2ec] px-3 py-2 text-sm font-semibold lg:gap-1.5 lg:px-2.5 lg:py-1.5 lg:text-xs 2xl:gap-1.75 2xl:px-3 2xl:py-2 2xl:text-sm">
				<Settings class="size-4.25 lg:size-3.5 2xl:size-4.25" aria-hidden="true" />
				{copy.items[1]}
			</li>
			<li class="inline-flex items-center gap-1.75 rounded-full bg-[#f6f2ec] px-3 py-2 text-sm font-semibold lg:gap-1.5 lg:px-2.5 lg:py-1.5 lg:text-xs 2xl:gap-1.75 2xl:px-3 2xl:py-2 2xl:text-sm">
				<Link2 class="size-4.25 lg:size-3.5 2xl:size-4.25" aria-hidden="true" />
				{copy.items[2]}
			</li>
		</ul>

		<div class="mt-7.5 flex max-w-105 items-end justify-between gap-4 lg:mt-6 lg:max-w-84 lg:gap-3 2xl:mt-7.5 2xl:max-w-105 2xl:gap-4 max-[900px]:max-w-none max-[350px]:flex-col max-[350px]:items-start">
			<div class="flex min-w-0 flex-1 flex-col rounded-[15px] bg-[#e8d9bf] px-4 py-3.25 text-sm leading-tight lg:rounded-xl lg:px-3 lg:py-2.5 lg:text-xs 2xl:rounded-[15px] 2xl:px-4 2xl:py-3.25 2xl:text-sm">
				<strong class="text-base lg:text-sm 2xl:text-base">Creator Partner</strong>
				<span>{copy.partner}</span>
			</div>
			<img class="size-16 shrink-0 object-contain sm:size-21 lg:size-17 2xl:size-21" src="/images/logo_m.avif" alt="Managero" width={sizeOf("/images/logo_m.avif")?.width} height={sizeOf("/images/logo_m.avif")?.height} loading="lazy" />
		</div>
	</div>

	<div class="grid min-w-0 grid-cols-6 grid-rows-[250px_145px] gap-3.5 lg:grid-rows-[200px_116px] lg:gap-3 2xl:grid-rows-[250px_145px] 2xl:gap-3.5 max-sm:grid-cols-2 max-sm:grid-rows-none max-sm:auto-rows-35 max-sm:gap-2" aria-label={copy.gallery}>
		{galleryImages.map((image, index) => (
			<img class:list={["size-full rounded-[22px] object-cover object-center max-sm:rounded-[14px]", index < 3 ? "col-span-2 max-sm:col-span-1" : "col-span-3", index === 3 && "max-sm:col-span-1", index === 4 && "max-sm:col-span-2"]} src={image} alt={copy.alts[index]} width={sizeOf(image)?.width} height={sizeOf(image)?.height} loading="lazy" />
		))}
	</div>
	</div>
</section>
