---
import ProcessPath from "@/assets/icons/process-path.svg";
import ProcessStep from "@/components/ui/ProcessStep.astro";
import { processSteps } from "@/data/process";
---

<section
	class="mt-8 px-4 sm:px-6 lg:mt-6.5 lg:px-8 2xl:mt-8 2xl:px-14 max-sm:mt-5"
	aria-labelledby="process-title"
>
	<div
		class="relative mx-auto w-full max-w-425 overflow-hidden rounded-[34px] bg-[#f8f3ed] px-[clamp(20px,3vw,48px)] pt-7.5 pb-11 lg:rounded-[28px] lg:px-10 lg:pt-6 lg:pb-9 2xl:rounded-[34px] 2xl:px-12 2xl:pt-7.5 2xl:pb-11 max-sm:rounded-[25px] max-sm:px-3.5 max-sm:pt-6.5 max-sm:pb-3.5"
	>
		<ProcessPath class="absolute inset-0 size-full opacity-75" aria-hidden="true" />
		<div class="relative z-1">
			<h2 id="process-title" class="font-heading text-3xl leading-none font-bold sm:text-5xl 2xl:text-6xl">Así trabajamos</h2>

			<div class="mt-5 grid grid-cols-4 gap-4.5 lg:mt-4 lg:gap-3.5 2xl:mt-5 2xl:gap-4.5 max-lg:grid-cols-2 max-sm:mt-4.5 max-sm:grid-cols-1 max-sm:gap-2.5">
				{processSteps.map((step, index) => (
					<ProcessStep step={step} featured={index === processSteps.length - 1} />
				))}
			</div>
		</div>
	</div>
</section>
