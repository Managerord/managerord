---
import SectionHeading from "@/components/ui/SectionHeading.astro";
import ServiceCard from "@/components/ui/ServiceCard.astro";
import { getServices } from "@/data/services";
import { type Locale, ui } from "@/i18n/content";

interface Props {
	locale?: Locale;
}
const { locale = "es" } = Astro.props;
const copy = ui[locale].services;
const services = getServices(locale);
---

<section id={locale === "es" ? "servicios" : "services"} class="bg-warm-white px-4 pb-16 sm:px-6 sm:pb-20 lg:px-8 lg:pb-22 2xl:px-14 2xl:pb-28">
	<div class="mx-auto w-full max-w-425">
		<SectionHeading
			title={copy.title}
			description={copy.description}
		/>
		<div class="mt-8 grid gap-4 sm:mt-12 sm:grid-cols-2 lg:mt-10 lg:grid-cols-3 2xl:mt-12">
			{services.map((service) => (
				<ServiceCard service={service} />
			))}
		</div>
	</div>
</section>
