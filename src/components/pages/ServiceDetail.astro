---
import ChevronRight from "@/assets/icons/chevron-right.svg";
import Footer from "@/components/layout/Footer.astro";
import Navbar from "@/components/layout/Navbar.astro";
import Button from "@/components/ui/Button.astro";
import { business } from "@/data/locations";
import { ORGANIZATION_ID } from "@/data/organization";
import {
	getRelatedServices,
	type LocalizedServiceEntry,
	servicesIndexPath,
} from "@/data/services";
import { type Locale, localePath, talkPath, ui } from "@/i18n/content";
import Layout from "@/layouts/Layout.astro";

interface Props {
	locale: Locale;
	service: LocalizedServiceEntry;
}

const { locale, service } = Astro.props;
const copy = ui[locale].servicePage;
const nav = ui[locale].nav;
const contactHref = `${talkPath(locale)}?service=${service.id}`;
const indexHref = servicesIndexPath(locale);
const related = getRelatedServices(locale, service.id);

const schema = [
	{
		"@context": "https://schema.org",
		"@type": "Service",
		name: service.title,
		description: service.seoDescription,

		provider: { "@id": ORGANIZATION_ID },
		areaServed: [
			{ "@type": "Country", name: business.countryName[locale] },
			{ "@type": "City", name: business.city },
		],
		url: new URL(service.href, Astro.site).href,
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",

		itemListElement: [
			{
				"@type": "ListItem",
				position: 1,
				name: nav.home,
				item: new URL(localePath(locale), Astro.site).href,
			},
			{
				"@type": "ListItem",
				position: 2,
				name: nav.services,
				item: new URL(indexHref, Astro.site).href,
			},
			{
				"@type": "ListItem",
				position: 3,
				name: service.title,
				item: new URL(service.href, Astro.site).href,
			},
		],
	},
];
---

<Layout
	locale={locale}
	title={service.seoTitle}
	description={service.seoDescription}
	canonicalPath={service.href}
	alternatePath={service.alternatePath}
	image={service.ogImage}
	imageAlt={service.imageAlt}
	schema={schema}
	preloadImage={{ href: service.image }}
>
	<Navbar locale={locale} alternatePath={service.alternatePath} />
	<main>
		<section class="px-2 pb-12 sm:px-6 sm:pb-20 lg:px-8 2xl:px-14">
			<div class="mx-auto grid max-w-425 overflow-hidden rounded-3xl bg-cream-100 lg:grid-cols-[0.9fr_1.1fr] 2xl:rounded-4xl">
				<div class="flex flex-col justify-center p-7 sm:p-12 lg:p-14 2xl:p-20">
					<nav class="flex flex-wrap items-center gap-2 text-sm text-muted" aria-label="Breadcrumb">
						<a class="transition-colors hover:text-orange-500" href={localePath(locale)}>{nav.home}</a>
						<ChevronRight class="size-3" aria-hidden="true" />
						<a class="transition-colors hover:text-orange-500" href={indexHref}>{nav.services}</a>
						<ChevronRight class="size-3" aria-hidden="true" />
						<span aria-current="page">{service.title}</span>
					</nav>
					<p class="mt-10 font-heading text-sm font-semibold tracking-[0.18em] text-orange-500 uppercase">{copy.eyebrow}</p>
					<h1 class="mt-4 font-heading text-3xl leading-[1.05] font-bold tracking-[-0.035em] sm:text-5xl 2xl:text-6xl">{service.h1}</h1>
					<p class="mt-6 text-lg leading-relaxed text-muted sm:text-xl">{service.description}</p>
					<Button href={contactHref} class="mt-8 w-fit bg-orange-500 text-white hover:bg-orange-600">{copy.cta}</Button>
				</div>
				<img
					src={service.image}
					alt={service.imageAlt}
					width={service.imageWidth}
					height={service.imageHeight}
					fetchpriority="high"
					decoding="async"
					class="h-full min-h-85 w-full object-cover sm:min-h-120"
				/>
			</div>
		</section>

		<section class="px-4 py-12 sm:px-6 sm:py-20 lg:px-8 2xl:px-14 2xl:py-28" aria-labelledby="service-included">
			<div class="mx-auto grid max-w-425 gap-10 lg:grid-cols-[0.75fr_1fr] lg:gap-20">
				<div>
					<p class="font-heading text-sm font-semibold tracking-[0.18em] text-orange-500 uppercase">{copy.helpTitle}</p>
					<h2 class="mt-5 font-heading text-3xl leading-14 font-bold sm:text-5xl">{service.intro}</h2>
				</div>
				<div>
					<h2 id="service-included" class="font-heading text-2xl font-bold sm:text-3xl">{copy.includedTitle}</h2>
					<ul class="mt-7 grid gap-3">
						{service.capabilities.map((capability, index) => (
							<li class="flex items-center gap-4 rounded-2xl bg-cream-100 p-5 text-lg"><span class="font-heading text-sm font-bold text-orange-500">0{index + 1}</span>{capability}</li>
						))}
					</ul>
				</div>
			</div>
		</section>

		<section class="bg-cream-100 px-4 py-12 sm:px-6 sm:py-20 lg:px-8 2xl:px-14 2xl:py-28" aria-labelledby="service-details">
			<div class="mx-auto max-w-425">
				<h2 id="service-details" class="font-heading text-3xl leading-tight font-bold sm:text-5xl">{copy.detailsTitle}</h2>
				<div class="mt-10 grid gap-6 lg:mt-14 lg:grid-cols-3">
					{service.details.map((block, index) => (
						<article class="rounded-3xl bg-white p-7 2xl:p-9">
							<span class="font-heading text-sm font-bold text-orange-500">0{index + 1}</span>
							<h3 class="mt-3 font-heading text-xl font-bold sm:text-2xl">{block.title}</h3>
							<p class="mt-3 text-base leading-relaxed text-muted sm:text-lg">{block.text}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="px-4 py-12 sm:px-6 sm:py-20 lg:px-8 2xl:px-14 2xl:py-28" aria-labelledby="service-related">
			<div class="mx-auto max-w-425">
				<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
					<div>
						<h2 id="service-related" class="font-heading text-3xl leading-tight font-bold sm:text-4xl">{copy.relatedTitle}</h2>
						<p class="mt-3 max-w-180 text-lg leading-relaxed text-muted">{copy.relatedDescription}</p>
					</div>
					<a class="shrink-0 font-heading text-base font-semibold text-orange-500 underline underline-offset-4 hover:text-orange-600" href={indexHref}>{copy.allServices}</a>
				</div>
				<ul class="mt-8 grid gap-4 sm:grid-cols-3">
					{related.map((item) => (
						<li>
							<a class="group flex h-full flex-col justify-between gap-5 rounded-3xl bg-cream-100 p-6 transition-colors hover:bg-sand-100 2xl:p-8" href={item.href}>
								<div>
									<h3 class="font-heading text-xl font-semibold sm:text-2xl">{item.title}</h3>
									<p class="mt-2 text-base leading-relaxed text-muted">{item.description}</p>
								</div>
								<ChevronRight class="size-4 text-orange-500 transition-transform group-hover:translate-x-1" aria-hidden="true" />
							</a>
						</li>
					))}
				</ul>
			</div>
		</section>

		<section class="px-4 pb-14 sm:px-6 sm:pb-20 lg:px-8 2xl:px-14 2xl:pb-28">
			<div class="mx-auto flex max-w-425 flex-col items-start justify-between gap-8 rounded-3xl bg-charcoal p-8 text-white sm:p-12 lg:flex-row lg:items-end 2xl:p-16">
				<div><h2 class="max-w-200 font-heading text-3xl leading-tight font-bold sm:text-5xl">{copy.ctaTitle}</h2><p class="mt-4 max-w-180 text-lg text-white/65">{copy.ctaDescription}</p></div>
				<Button href={contactHref} class="shrink-0 bg-orange-500 text-white hover:bg-orange-600">{copy.cta}</Button>
			</div>
		</section>
	</main>
	<Footer locale={locale} />
</Layout>
