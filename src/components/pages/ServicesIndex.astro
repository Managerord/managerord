---
import ChevronRight from "@/assets/icons/chevron-right.svg";
import Footer from "@/components/layout/Footer.astro";
import Navbar from "@/components/layout/Navbar.astro";
import Button from "@/components/ui/Button.astro";
import ExtraServiceCard from "@/components/ui/ExtraServiceCard.astro";
import ServiceCard from "@/components/ui/ServiceCard.astro";
import {
	getAllServices,
	getExtraServices,
	getServices,
	servicesIndexPath,
} from "@/data/services";
import { type Locale, localePath, talkPath, ui } from "@/i18n/content";
import Layout from "@/layouts/Layout.astro";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const alternateLocale: Locale = locale === "es" ? "en" : "es";
const copy = ui[locale].servicesIndex;
const nav = ui[locale].nav;
const servicePageCopy = ui[locale].servicePage;
const canonicalPath = servicesIndexPath(locale);
const alternatePath = servicesIndexPath(alternateLocale);

const featured = getServices(locale);
const extra = getExtraServices(locale);

const schema = [
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{
				"@type": "ListItem",
				position: 1,
				name: nav.home,
				item: new URL(localePath(locale), Astro.site).href,
			},
			{
				"@type": "ListItem",
				position: 2,
				name: nav.services,
				item: new URL(canonicalPath, Astro.site).href,
			},
		],
	},
	{
		"@context": "https://schema.org",
		"@type": "ItemList",
		name: copy.title,
		itemListElement: getAllServices(locale).map((service, index) => ({
			"@type": "ListItem",
			position: index + 1,
			name: service.title,
			url: new URL(service.href, Astro.site).href,
		})),
	},
];
---

<Layout
	locale={locale}
	title={copy.seoTitle}
	description={copy.seoDescription}
	canonicalPath={canonicalPath}
	alternatePath={alternatePath}
	schema={schema}
>
	<Navbar locale={locale} alternatePath={alternatePath} />
	<main>
		<section class="px-2 pb-12 sm:px-6 sm:pb-20 lg:px-8 2xl:px-14">
			<div class="mx-auto max-w-425 rounded-3xl bg-cream-100 p-7 sm:p-12 lg:p-16 2xl:rounded-4xl 2xl:p-20">
				<nav class="flex flex-wrap items-center gap-2 text-sm text-muted" aria-label="Breadcrumb">
					<a class="transition-colors hover:text-orange-500" href={localePath(locale)}>{nav.home}</a>
					<ChevronRight class="size-3" aria-hidden="true" />
					<span aria-current="page">{nav.services}</span>
				</nav>
				<p class="mt-10 font-heading text-sm font-semibold tracking-[0.18em] text-orange-500 uppercase">{copy.eyebrow}</p>
				<h1 class="mt-4 max-w-240 font-heading text-3xl leading-[1.05] font-bold tracking-[-0.035em] sm:text-5xl 2xl:text-6xl">{copy.title}</h1>
				<p class="mt-6 max-w-190 text-lg leading-relaxed text-muted sm:text-xl">{copy.description}</p>
			</div>
		</section>

		<section class="px-4 pb-12 sm:px-6 sm:pb-20 lg:px-8 2xl:px-14" aria-labelledby="services-featured">
			<div class="mx-auto w-full max-w-425">
				<h2 id="services-featured" class="font-heading text-3xl leading-tight font-bold sm:text-5xl">{copy.featuredTitle}</h2>
				<p class="mt-3 max-w-190 text-lg leading-relaxed text-muted sm:text-xl">{copy.featuredDescription}</p>
				<div class="mt-8 grid gap-4 sm:grid-cols-2 lg:mt-10 lg:grid-cols-3">
					{featured.map((service) => <ServiceCard service={service} />)}
				</div>
			</div>
		</section>

		<section class="px-4 pb-12 sm:px-6 sm:pb-20 lg:px-8 2xl:px-14" aria-labelledby="services-extra">
			<div class="mx-auto w-full max-w-425">
				<h2 id="services-extra" class="font-heading text-3xl leading-tight font-bold sm:text-5xl">{copy.extraTitle}</h2>
				<p class="mt-3 max-w-190 text-lg leading-relaxed text-muted sm:text-xl">{copy.extraDescription}</p>
				<div class="mt-8 grid gap-6 lg:mt-10 lg:grid-cols-2 lg:gap-6 2xl:gap-8">
					{extra.map((service) => <ExtraServiceCard service={service} />)}
				</div>
			</div>
		</section>

		<section class="px-4 pb-14 sm:px-6 sm:pb-20 lg:px-8 2xl:px-14 2xl:pb-28">
			<div class="mx-auto flex max-w-425 flex-col items-start justify-between gap-8 rounded-3xl bg-charcoal p-8 text-white sm:p-12 lg:flex-row lg:items-end 2xl:p-16">
				<div>
					<h2 class="max-w-200 font-heading text-3xl leading-tight font-bold sm:text-5xl">{servicePageCopy.ctaTitle}</h2>
					<p class="mt-4 max-w-180 text-lg text-white/65">{servicePageCopy.ctaDescription}</p>
				</div>
				<Button href={talkPath(locale)} class="shrink-0 bg-orange-500 text-white hover:bg-orange-600">{servicePageCopy.cta}</Button>
			</div>
		</section>
	</main>
	<Footer locale={locale} />
</Layout>
