---
import ServiceDetail from "@/components/pages/ServiceDetail.astro";
import { getAllServices } from "@/data/services";

export function getStaticPaths() {
	return getAllServices("en").map((service) => ({
		params: { slug: service.slug },
		props: { service },
	}));
}
const { service } = Astro.props;
---
<ServiceDetail locale="en" service={service} />
